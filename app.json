{
  "expo": {
    "name": "Finz",
    "slug": "Finz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "finz",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.finz.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "O Finz precisa de acesso às suas fotos para importar comprovantes de pagamento.",
        "NSCameraUsageDescription": "O Finz precisa de acesso à câmera para fotografar comprovantes de pagamento."
      }
    },
    "android": {
      "package": "com.finz.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c0d12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "application/pdf"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-sqlite",
      "expo-font",
      "expo-image-picker",
      "expo-document-picker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "9d8c6867-298d-4747-b06b-8cccc7eb8caf"
      }
    }
  }
}
